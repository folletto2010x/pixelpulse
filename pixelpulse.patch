+package com.unshoo.pixelmusic.data.lyrics.pulse
+
+import com.unshoo.pixelmusic.data.model.Lyrics
+import com.unshoo.pixelmusic.data.model.Song
+import com.unshoo.pixelmusic.utils.LyricsUtils
+
+/**
+ * Bridge between Pulse's lyrics providers and Pixel Music's pipeline.
+ *
+ * Pulse returns `List<LyricLine>` (word timings, background vocals, alignment).
+ * Pixel stores lyrics as a raw LRC string and parses it with [LyricsUtils], which
+ * already understands enhanced-LRC word tags (`<mm:ss.xx>`). So the result is
+ * serialized with Pulse's own `toEnhancedLrc()` and handed to that parser:
+ * no database or model changes needed.
+ */
+object PulseLyricsProvider {
+
+    data class Config(
+        val sources: Set<LyricsSource> = LyricsSource.entries.toSet(),
+        val order: List<LyricsSource> = LyricsSource.entries,
+        val prioritizeWordSync: Boolean = true,
+    )
+
+    /** Returns parsed lyrics plus the raw enhanced-LRC to persist, or null on a miss. */
+    suspend fun fetch(song: Song, config: Config): Pair<Lyrics, String>? {
+        if (config.sources.isEmpty()) return null
+        val result = LyricsRepository.lyrics(
+            // Local songs have no YouTube id; the id is only used as a cache key
+            // and by SimpMusic, which will simply miss for local tracks.
+            videoId = song.id,
+            title = song.title,
+            artist = song.displayArtist,
+            durationMs = song.duration,
+            album = song.album.takeIf { it.isNotBlank() },
+            sources = config.sources,
+            order = config.order,
+            prioritizeSyllableSync = config.prioritizeWordSync,
+        ) ?: return null
+        if (result.lines.isEmpty()) return null
+        val raw = result.lines.toEnhancedLrc()
+        val parsed = LyricsUtils.parseLyrics(raw)
+        if (parsed.synced.isNullOrEmpty() && parsed.plain.isNullOrEmpty()) return null
+        return parsed.copy(areFromRemote = true) to raw
+    }
+}
