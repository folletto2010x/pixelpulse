@@ -0,0 +1,97 @@
+package com.unshoo.pixelmusic.presentation.components.player.pulse
+
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.remember
+import androidx.compose.ui.Modifier
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.unshoo.pixelmusic.data.lyrics.pulse.LyricLine
+import com.unshoo.pixelmusic.data.lyrics.pulse.LyricWord
+import com.unshoo.pixelmusic.data.lyrics.pulse.PulseUiSettings
+import com.unshoo.pixelmusic.data.model.SyncedLine
+import kotlinx.coroutines.flow.StateFlow
+
+/**
+ * Converts Pixel Music's [SyncedLine]s into Pulse's [LyricLine]s.
+ *
+ * Pixel stores word starts only, so each word ends where the next one starts; the last word of
+ * a line ends where the next line begins. The line text is rebuilt from the words, because
+ * Pulse locates each word inside the line text by searching for it in order.
+ */
+internal fun List<SyncedLine>.toPulseLyricLines(): List<LyricLine> = mapIndexed { index, line ->
+    val nextLineStart = getOrNull(index + 1)?.time?.toLong()
+    val sourceWords = line.words.orEmpty()
+    if (sourceWords.isEmpty()) {
+        LyricLine(timeMs = line.time.toLong(), text = line.line)
+    } else {
+        val text = buildString {
+            sourceWords.forEachIndexed { i, w ->
+                if (i > 0 && w.startsNewWord) append(' ')
+                append(w.word)
+            }
+        }
+        val words = sourceWords.mapIndexed { i, w ->
+            val start = w.time.toLong()
+            val end = sourceWords.getOrNull(i + 1)?.time?.toLong()
+                ?: nextLineStart
+                ?: (start + 1_200L)
+            LyricWord(startMs = start, endMs = maxOf(end, start + 1L), text = w.word)
+        }
+        LyricLine(timeMs = line.time.toLong(), text = text, words = words)
+    }
+}
+
+/** Translation (or romanization) of every line, index for index; null when no line has one. */
+internal fun List<SyncedLine>.toPulseSubLines(): List<LyricLine>? {
+    if (none { !it.translation.isNullOrBlank() || !it.romanization.isNullOrBlank() }) return null
+    return map { line ->
+        LyricLine(
+            timeMs = line.time.toLong(),
+            text = (line.translation?.takeIf { it.isNotBlank() } ?: line.romanization).orEmpty(),
+        )
+    }
+}
+
+/**
+ * Pulse's synced-lyrics panel (word-by-word sweep, blur falloff, duet lanes, gap dots) fed from
+ * Pixel Music's data. Sync offset follows Pixel's convention: positive values bring lyrics forward.
+ */
+@Composable
+fun PulseSyncedLyricsView(
+    lines: List<SyncedLine>,
+    playbackPositionFlow: StateFlow<Long>,
+    isPlaying: Boolean,
+    lyricsSyncOffset: Int,
+    onSeekToMs: (Long) -> Unit,
+    modifier: Modifier = Modifier,
+    blurEnabled: Boolean = true,
+) {
+    // The panel reads these as global flows; the app-wide blur switch drives them.
+    LaunchedEffect(blurEnabled) {
+        PulseUiSettings.lyricsBlur.value = blurEnabled
+        PulseUiSettings.reduceDynamicBlur.value = !blurEnabled
+    }
+    val pulseLines = remember(lines) { lines.toPulseLyricLines() }
+    val subLines = remember(lines) { lines.toPulseSubLines() }
+    val trackKey = remember(lines) { lines.hashCode().toString() }
+    val position by playbackPositionFlow.collectAsStateWithLifecycle()
+
+    LyricsPanel(
+        lines = pulseLines,
+        subLines = subLines,
+        trackKey = trackKey,
+        positionMs = (position + lyricsSyncOffset).coerceAtLeast(0L),
+        looking = false,
+        isPlaying = isPlaying,
+        onSeekToLine = { lineTimeMs ->
+            onSeekToMs((lineTimeMs - lyricsSyncOffset).coerceAtLeast(0L))
+        },
+        // Pixel's own sheet owns the player controls; the panel never needs to reveal/hide them.
+        controlsOpen = true,
+        onRevealControls = {},
+        onHideControls = {},
+        modifier = modifier.fillMaxSize(),
+    )
+}
