+import com.unshoo.pixelmusic.data.lyrics.pulse.LyricsSource
+
+/**
+ * Lets the user enable/disable each Pulse lyrics provider and set the order they are tried in.
+ * [saved] is the persisted ordered list of enabled provider names, or null for "defaults" (all enabled).
+ * [onSave] receives the enabled providers, in priority order.
+ */
+@Composable
+fun PulseLyricsSourcesDialog(
+    saved: List<String>?,
+    onSave: (List<String>) -> Unit,
+    onDismiss: () -> Unit,
+) {
+    val all = LyricsSource.entries
+    val initialEnabled = remember(saved) {
+        saved?.mapNotNull { n -> all.firstOrNull { it.name == n } } ?: all
+    }
+    // Enabled ones first in the saved order, then the rest in default order.
+    val items = remember(saved) {
+        mutableStateListOf<LyricsSource>().apply {
+            addAll(initialEnabled)
+            addAll(all.filter { it !in initialEnabled })
+        }
+    }
+    val enabled = remember(saved) { mutableStateListOf<LyricsSource>().apply { addAll(initialEnabled) } }
+
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        title = { Text("Provider lyrics (Pulse)") },
+        text = {
+            Column {
+                Text(
+                    "Vengono provati dall'alto verso il basso. Quelli disattivati non vengono mai contattati.",
+                    style = MaterialTheme.typography.bodySmall,
+                    modifier = Modifier.padding(bottom = 8.dp),
+                )
+                LazyColumn(modifier = Modifier.heightIn(max = 420.dp)) {
+                    itemsIndexed(items, key = { _, it -> it.name }) { index, source ->
+                        val isOn = source in enabled
+                        Row(
+                            modifier = Modifier
+                                .fillMaxWidth()
+                                .clickable { if (isOn) enabled.remove(source) else enabled.add(source) },
+                            verticalAlignment = Alignment.CenterVertically,
+                            horizontalArrangement = Arrangement.spacedBy(4.dp),
+                        ) {
+                            Checkbox(
+                                checked = isOn,
+                                onCheckedChange = { if (it) enabled.add(source) else enabled.remove(source) },
+                            )
+                            Column(modifier = Modifier.weight(1f)) {
+                                Text(
+                                    source.label + if (source.wordSynced) "  \u2022 parola per parola" else "",
+                                    style = MaterialTheme.typography.bodyMedium,
+                                )
+                                Text(
+                                    source.detail,
+                                    style = MaterialTheme.typography.bodySmall,
+                                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                                )
+                            }
+                            IconButton(
+                                enabled = index > 0,
+                                onClick = { val s = items.removeAt(index); items.add(index - 1, s) },
+                            ) { Icon(Icons.Rounded.KeyboardArrowUp, contentDescription = "Su") }
+                            IconButton(
+                                enabled = index < items.lastIndex,
+                                onClick = { val s = items.removeAt(index); items.add(index + 1, s) },
+                            ) { Icon(Icons.Rounded.KeyboardArrowDown, contentDescription = "Gi\u00f9") }
+                        }
+                    }
+                }
+            }
+        },
+        confirmButton = {
+            TextButton(onClick = { onSave(items.filter { it in enabled }.map { it.name }) }) { Text("Salva") }
+        },
+        dismissButton = {
+            Row {
+                TextButton(onClick = {
+                    items.clear(); items.addAll(all)
+                    enabled.clear(); enabled.addAll(all)
+                }) { Text("Ripristina") }
+                TextButton(onClick = onDismiss) { Text("Annulla") }
+            }
+        },
+    )
+}
