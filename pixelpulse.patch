+package com.unshoo.pixelmusic.data.lyrics.pulse
+
+import okhttp3.OkHttpClient
+import java.util.concurrent.TimeUnit
+
+/**
+ * Minimal replacement for Pulse's app-wide `Http` object.
+ * Pulse shared one client between Innertube and ExoPlayer; here the lyrics
+ * providers only need a plain client with sane timeouts.
+ */
+object PulseHttp {
+    val client: OkHttpClient by lazy {
+        OkHttpClient.Builder()
+            .connectTimeout(10, TimeUnit.SECONDS)
+            .readTimeout(15, TimeUnit.SECONDS)
+            .callTimeout(25, TimeUnit.SECONDS)
+            .build()
+    }
+}
