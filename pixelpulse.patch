+/** Seeds offered for the fixed ("single") player theme. */
+val PlayerFixedSeedPalette: List<Int> = listOf(
+    0xFF6750A4, 0xFF1E6FD9, 0xFF00897B, 0xFF43A047,
+    0xFFF57C00, 0xFFD32F2F, 0xFFD81B60, 0xFF607D8B,
+).map { it.toInt() }
+
+/**
+ * Player theme chooser for Settings: three cards, each with a small mock of the player painted in
+ * that mode's colors, plus a swatch row for the fixed theme's color.
+ */
+@Composable
+fun PlayerThemeModePicker(
+    selected: String,
+    fixedSeed: Int,
+    onSelect: (String) -> Unit,
+    onFixedSeedChange: (Int) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val dark = LocalPixelPlayerDarkTheme.current
+    val system = MaterialTheme.colorScheme
+    val fixed = remember(fixedSeed, dark) {
+        generateColorSchemeFromSeed(Color(fixedSeed)).let { if (dark) it.dark else it.light }
+    }
+
+    Column(modifier = modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 8.dp)) {
+        Text("Tema del player", style = MaterialTheme.typography.titleMedium)
+        Text(
+            "Scegli i colori del player a schermo intero",
+            style = MaterialTheme.typography.bodySmall,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+            modifier = Modifier.padding(top = 2.dp, bottom = 12.dp),
+        )
+        Row(horizontalArrangement = Arrangement.spacedBy(10.dp), modifier = Modifier.fillMaxWidth()) {
+            ModeCard(
+                title = "Copertina",
+                selected = selected == ThemePreference.ALBUM_ART,
+                onClick = { onSelect(ThemePreference.ALBUM_ART) },
+                background = Brush.verticalGradient(listOf(Color(0xFFE8704A), Color(0xFF8E2C6B))),
+                art = Brush.linearGradient(listOf(Color(0xFFFFC27A), Color(0xFFB8325E))),
+                accent = Color.White,
+                onBackground = Color.White,
+                modifier = Modifier.weight(1f),
+            )
+            ModeCard(
+                title = "Tema unico",
+                selected = selected == ThemePreference.FIXED,
+                onClick = { onSelect(ThemePreference.FIXED) },
+                background = Brush.verticalGradient(listOf(fixed.primaryContainer, fixed.surfaceContainer)),
+                art = Brush.linearGradient(listOf(fixed.primary, fixed.tertiary)),
+                accent = fixed.primary,
+                onBackground = fixed.onSurface,
+                modifier = Modifier.weight(1f),
+            )
+            ModeCard(
+                title = "Material You",
+                selected = selected == ThemePreference.DYNAMIC,
+                onClick = { onSelect(ThemePreference.DYNAMIC) },
+                background = Brush.verticalGradient(listOf(system.primaryContainer, system.surfaceContainer)),
+                art = Brush.linearGradient(listOf(system.primary, system.tertiary)),
+                accent = system.primary,
+                onBackground = system.onSurface,
+                modifier = Modifier.weight(1f),
+            )
+        }
+
+        if (selected == ThemePreference.FIXED) {
+            Text(
+                "Colore del tema",
+                style = MaterialTheme.typography.labelLarge,
+                modifier = Modifier.padding(top = 14.dp, bottom = 8.dp),
+            )
+            Row(horizontalArrangement = Arrangement.spacedBy(10.dp)) {
+                PlayerFixedSeedPalette.forEach { seed ->
+                    val isSelected = seed == fixedSeed
+                    Box(
+                        modifier = Modifier
+                            .size(32.dp)
+                            .clip(CircleShape)
+                            .background(Color(seed))
+                            .border(
+                                width = if (isSelected) 3.dp else 1.dp,
+                                color = if (isSelected) MaterialTheme.colorScheme.onSurface
+                                else MaterialTheme.colorScheme.outlineVariant,
+                                shape = CircleShape,
+                            )
+                            .clickable { onFixedSeedChange(seed) },
+                    )
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun ModeCard(
+    title: String,
+    selected: Boolean,
+    onClick: () -> Unit,
+    background: Brush,
+    art: Brush,
+    accent: Color,
+    onBackground: Color,
+    modifier: Modifier = Modifier,
+) {
+    val shape = RoundedCornerShape(16.dp)
+    Column(
+        modifier = modifier,
+        horizontalAlignment = Alignment.CenterHorizontally,
+    ) {
+        Box(
+            modifier = Modifier
+                .fillMaxWidth()
+                .aspectRatio(0.62f)
+                .clip(shape)
+                .background(background)
+                .border(
+                    border = if (selected) BorderStroke(3.dp, MaterialTheme.colorScheme.primary)
+                    else BorderStroke(1.dp, MaterialTheme.colorScheme.outlineVariant),
+                    shape = shape,
+                )
+                .clickable(onClick = onClick)
+                .padding(10.dp),
+        ) {
+            // Mini player: artwork, title/artist lines, progress, play button.
+            Column(
+                modifier = Modifier.fillMaxWidth().fillMaxHeight(),
+                horizontalAlignment = Alignment.CenterHorizontally,
+                verticalArrangement = Arrangement.spacedBy(6.dp),
+            ) {
+                Box(
+                    modifier = Modifier
+                        .fillMaxWidth(0.82f)
+                        .aspectRatio(1f)
+                        .clip(RoundedCornerShape(10.dp))
+                        .background(art),
+                )
+                Box(Modifier.fillMaxWidth(0.7f).height(6.dp).clip(CircleShape).background(onBackground.copy(alpha = 0.85f)))
+                Box(Modifier.fillMaxWidth(0.45f).height(5.dp).clip(CircleShape).background(onBackground.copy(alpha = 0.45f)))
+                Box(Modifier.fillMaxWidth().height(3.dp).clip(CircleShape).background(onBackground.copy(alpha = 0.25f))) {
+                    Box(Modifier.fillMaxWidth(0.4f).height(3.dp).background(accent))
+                }
+                Box(
+                    modifier = Modifier.size(22.dp).clip(CircleShape).background(accent),
+                )
+            }
+        }
+        Text(
+            title,
+            style = MaterialTheme.typography.labelMedium,
+            fontWeight = if (selected) FontWeight.Bold else FontWeight.Normal,
+            modifier = Modifier.padding(top = 6.dp),
+        )
+    }
+}
