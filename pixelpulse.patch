+package com.unshoo.pixelmusic.presentation.components.player.pulse
+
+import android.os.Build
+import android.view.HapticFeedbackConstants
+import android.view.View
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.remember
+import androidx.compose.ui.platform.LocalView
+
+/** The few feedback cues Pulse's lyrics UI plays. */
+enum class Haptic { Select, Tap, ToggleOn }
+
+/** Thin wrapper over the platform's haptic feedback (honours the system "touch feedback" setting). */
+class Haptics internal constructor(private val view: View) {
+    fun play(haptic: Haptic) {
+        val constant = when (haptic) {
+            Haptic.Select -> HapticFeedbackConstants.CLOCK_TICK
+            Haptic.Tap -> HapticFeedbackConstants.VIRTUAL_KEY
+            Haptic.ToggleOn ->
+                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) HapticFeedbackConstants.CONFIRM
+                else HapticFeedbackConstants.KEYBOARD_TAP
+        }
+        view.performHapticFeedback(constant)
+    }
+}
+
+@Composable
+fun rememberHaptics(): Haptics {
+    val view = LocalView.current
+    return remember(view) { Haptics(view) }
+}
diff --git a/app/src/main/java/com/unshoo/pixelmusic/presentation/components/player/pulse/LyricClock.kt b/app/src/main/java/com/unshoo/pixelmusic/presentation/components/player/pulse/LyricClock.kt
