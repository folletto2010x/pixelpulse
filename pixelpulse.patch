+package com.unshoo.pixelmusic.presentation.components.player
+
+import android.os.Build
+import androidx.compose.foundation.background
+import androidx.compose.foundation.border
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.shape.RoundedCornerShape
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.draw.blur
+import androidx.compose.ui.draw.clip
+import androidx.compose.ui.graphics.Brush
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.graphicsLayer
+import androidx.compose.ui.layout.ContentScale
+import androidx.compose.ui.unit.dp
+import coil.compose.AsyncImage
+import com.unshoo.pixelmusic.presentation.components.LocalMaterialTheme
+import dev.chrisbanes.haze.HazeState
+import dev.chrisbanes.haze.hazeEffect
+import dev.chrisbanes.haze.hazeSource
+import dev.chrisbanes.haze.materials.ExperimentalHazeMaterialsApi
+import dev.chrisbanes.haze.materials.HazeMaterials
+
+/**
+ * iOS-style backdrop for the full player: the cover, enlarged and blurred, under a tinted veil
+ * taken from the player's color scheme (so it follows Cover / Fixed / Material You themes).
+ *
+ * It is the Haze *source*: [glassPanel] surfaces placed above it frost whatever is behind them.
+ *
+ * [nativeBlur] uses Android's RenderEffect blur (API 31+). When off, or on older Android, the
+ * cover is not drawn at all and a plain tinted gradient is used: cheaper and still coherent.
+ */
+@Composable
+fun GlassPlayerBackdrop(
+    artUri: String?,
+    nativeBlur: Boolean,
+    hazeState: HazeState,
+    modifier: Modifier = Modifier,
+) {
+    val scheme = LocalMaterialTheme.current
+    val canBlur = nativeBlur && Build.VERSION.SDK_INT >= Build.VERSION_CODES.S && !artUri.isNullOrBlank()
+
+    Box(modifier = modifier.fillMaxSize().hazeSource(hazeState)) {
+        if (canBlur) {
+            AsyncImage(
+                model = artUri,
+                contentDescription = null,
+                contentScale = ContentScale.Crop,
+                modifier = Modifier
+                    .fillMaxSize()
+                    // Scaled up so the blurred edges stay outside the screen.
+                    .graphicsLayer { scaleX = 1.35f; scaleY = 1.35f }
+                    .blur(72.dp),
+            )
+        } else {
+            Box(
+                Modifier.fillMaxSize().background(
+                    Brush.verticalGradient(listOf(scheme.primaryContainer, scheme.surface))
+                )
+            )
+        }
+        // Veil: keeps text legible whatever the cover looks like.
+        Box(
+            Modifier.fillMaxSize().background(
+                Brush.verticalGradient(
+                    listOf(
+                        scheme.surface.copy(alpha = if (canBlur) 0.38f else 0.0f),
+                        scheme.surface.copy(alpha = if (canBlur) 0.62f else 0.0f),
+                    )
+                )
+            )
+        )
+    }
+}
+
+/** A frosted-glass rounded panel; place it as a sibling of (never inside) [GlassPlayerBackdrop]. */
+@OptIn(ExperimentalHazeMaterialsApi::class)
+@Composable
+fun Modifier.glassPanel(hazeState: HazeState, cornerRadius: Int = 28, blurEnabled: Boolean = true): Modifier {
+    val scheme = LocalMaterialTheme.current
+    val shape = RoundedCornerShape(cornerRadius.dp)
+    return this
+        .clip(shape)
+        .then(
+            if (blurEnabled) Modifier.hazeEffect(state = hazeState, style = HazeMaterials.ultraThin(scheme.surface))
+            // Blur off: a plain translucent surface, no sampling of what is behind.
+            else Modifier.background(scheme.surface.copy(alpha = 0.6f))
+        )
+        .border(1.dp, Color.White.copy(alpha = 0.14f), shape)
+}
